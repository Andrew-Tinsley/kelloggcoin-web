<h1>KelloggCoin Ledger</h1>

<!-- Step 1: List all transactions -->
<h2>Transactions</h2>
<ol>
  <% Transaction.all.each do |transaction| %>
    <% if transaction.from_user_id.nil? %>
      <li>Initial coin offering: <%= transaction.amount %> to <%= User.find(transaction.to_user_id).name %></li>
    <% else %>
      <li><%= transaction.amount %> KC from <%= User.find(transaction.from_user_id).name %> to <%= User.find(transaction.to_user_id).name %></li>
    <% end %>
  <% end %>
</ol>

<!-- Step 2 + Extra Fun: User balances as HTML table -->
<h2>Balances</h2>
<table>
  <tr>
    <th>User</th>
    <th>Balance (KC)</th>
  </tr>
  <% User.all.each do |user| %>
    <% received = Transaction.where({"to_user_id" => user.id}).sum("amount") %>
    <% sent = Transaction.where({"from_user_id" => user.id}).sum("amount") %>
    <% balance = received - sent %>
    <tr>
      <td><%= user.name %></td>
      <td><%= balance %> KC</td>
    </tr>
  <% end %>
</table>
